{
	auto_https disable_redirects
	admin off
	skip_install_trust
}

(placepulse) {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' ws: wss:; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(self), microphone=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@health path /healthz
	handle @health {
		respond "ok" 200
	}

	handle_path /api/* {
		reverse_proxy api:8000 {
			header_up X-PlacePulse-Client-IP {remote_host}
		}
	}

	handle /ws/* {
		reverse_proxy api:8000 {
			stream_close_delay 5m
		}
	}

	handle {
		root * /srv

		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@revalidate path /manifest.webmanifest /service-worker.js /icon.svg
		header @revalidate Cache-Control "no-cache, no-store, must-revalidate"

		route {
			try_files {path} /index.html
			header /index.html Cache-Control "no-cache, no-store, must-revalidate"
			file_server
		}
	}
}

:80 {
	import placepulse
}

https://localhost, https://web, https://127.0.0.1 {
	tls internal
	import placepulse
}
