# Non-secret application settings. Copy this file to .env before running Compose.
PLACEPULSE_ENV=local
PLACEPULSE_LOG_LEVEL=INFO
PLACEPULSE_POSTGRES_DB=placepulse
PLACEPULSE_POSTGRES_USER=placepulse
PLACEPULSE_REDIS_USER=placepulse
PLACEPULSE_DB_POOL_SIZE=5
PLACEPULSE_DB_MAX_OVERFLOW=5
PLACEPULSE_REDIS_POOL_SIZE=20
PLACEPULSE_CONNECT_TIMEOUT_SECONDS=2
PLACEPULSE_READINESS_TIMEOUT_SECONDS=1

# Required secrets. Set strong local values in the ignored .env file. The seed
# password must contain at least 12 characters.
# Compose mounts these environment values as files under /run/secrets.
PLACEPULSE_POSTGRES_PASSWORD=
PLACEPULSE_REDIS_PASSWORD=
PLACEPULSE_SEED_PASSWORD=
